{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f7fafb" },
      "foreground": { "$value": "#133039" },
      "border": { "$value": "#dce7ea" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#133039" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#133039" },
      "primary": {
        "$value": "#11536a",
        "$description": "Primary brand color. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#e5ecee" },
      "secondaryForeground": { "$value": "#11536a" },
      "muted": { "$value": "#edf3f4" },
      "mutedForeground": { "$value": "#52666c" },
      "accent": { "$value": "#e5ecee" },
      "accentForeground": { "$value": "#11536a" },
      "destructive": { "$value": "#c6242d" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#d0dee1" },
      "ring": { "$value": "#11536a" },
      "chart1": { "$value": "#11536a" },
      "chart2": { "$value": "#47a59a" },
      "chart3": { "$value": "#99aeb6" },
      "chart4": { "$value": "#5d95b8" },
      "chart5": { "$value": "#56758c" },
      "sidebar": { "$value": "#0b3443" },
      "sidebarForeground": { "$value": "#f7fafb" },
      "sidebarBorder": { "$value": "#092b37" },
      "sidebarPrimary": { "$value": "#145a76" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#145a76" },
      "sidebarAccentForeground": { "$value": "#ffffff" },
      "sidebarRing": { "$value": "#2c8caf" }
    },
    "dark": {
      "background": { "$value": "#102a33" },
      "foreground": { "$value": "#f5fafb" },
      "border": { "$value": "#23414a" },
      "card": { "$value": "#173740" },
      "cardForeground": { "$value": "#f5fafb" },
      "popover": { "$value": "#173740" },
      "popoverForeground": { "$value": "#f5fafb" },
      "primary": { "$value": "#43a5c2" },
      "primaryForeground": { "$value": "#08252e" },
      "secondary": { "$value": "#28505a" },
      "secondaryForeground": { "$value": "#f5fafb" },
      "muted": { "$value": "#21434c" },
      "mutedForeground": { "$value": "#a8bdc3" },
      "accent": { "$value": "#28505a" },
      "accentForeground": { "$value": "#f5fafb" },
      "destructive": { "$value": "#a6292e" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#2a4a53" },
      "ring": { "$value": "#43a5c2" },
      "chart1": { "$value": "#43a5c2" },
      "chart2": { "$value": "#5bc5b4" },
      "chart3": { "$value": "#9cb9c1" },
      "chart4": { "$value": "#76acd0" },
      "chart5": { "$value": "#88a6b7" },
      "sidebar": { "$value": "#0a1c22" },
      "sidebarForeground": { "$value": "#f5fafb" },
      "sidebarBorder": { "$value": "#18333b" },
      "sidebarPrimary": { "$value": "#257e9b" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#18333b" },
      "sidebarAccentForeground": { "$value": "#f5f5f5" },
      "sidebarRing": { "$value": "#43a5c2" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Plus Jakarta Sans", "sans-serif"],
        "$description": "Default UI and body typeface."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Spline Sans Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
